# EncoreBOM frontend — built SPA served by nginx.
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.frontend -t encorebom/frontend .
#
# Static build rather than a containerised `vite dev`. The dev server is for
# hot reload on a developer's machine; running it as the deployed artefact
# means shipping the toolchain, a watcher and source maps, and it exits on any
# type error — so a stack meant to stay up would go down on a bad edit.
#
# `npm run build` is `tsc -b && vite build`, so a type error fails the IMAGE
# BUILD. That is the intent: a broken build should never reach a running
# container.

# ---- build ----------------------------------------------------------------
FROM node:24-alpine AS build

WORKDIR /app

# Lockfile-only install first, for layer caching. `npm ci` (not `npm install`)
# so the lockfile is authoritative and a build can never silently float a
# dependency — this product's own SBOM has to be trustworthy.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ---- runtime ---------------------------------------------------------------
# nginx-unprivileged runs as uid 101 with no root master process, so the
# container needs no capabilities at all.
FROM nginxinc/nginx-unprivileged:alpine AS runtime

# The stock config listens on 8080 and would collide with the gateway's port
# in any host-network scenario; ours listens on 8085.
COPY --chown=nginx:nginx deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

USER nginx

EXPOSE 8085

# nginx already runs in the foreground under this image's default command.
