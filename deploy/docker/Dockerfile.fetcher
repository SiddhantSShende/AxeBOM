# AxeBOM fetcher — GENERATED by tools/gen-service
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.fetcher -t axebom/fetcher .
#
# The Go version below is read from go.mod at generation time. Do not edit it
# here — bump go.mod and re-run `go run ./tools/gen-service --all`.

# ---- build ----------------------------------------------------------------
FROM golang:1.26-alpine AS build

WORKDIR /src

# Dependencies first: this layer caches across source changes, which matters
# when eight images share the same module graph.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev

# CGO off for a static binary that runs on distroless/scratch.
# -trimpath keeps absolute build paths out of the binary, which is both a
# reproducibility and a minor information-disclosure concern.
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/fetcher ./services/fetcher

# ---- runtime --------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

# distroless/static: no shell, no package manager, no libc. Nothing to pivot to
# if the process is compromised. `nonroot` runs as uid 65532.
COPY --from=build /out/fetcher /fetcher

USER nonroot:nonroot

# Both ports the process actually binds. The metrics listener is HTTP+10000,
# derived from the same number the service reads — not a second constant that
# could disagree with it.
EXPOSE 8098 18098

# No HEALTHCHECK directive: this image has no shell and no curl, so a
# container-level probe is impossible by construction. Compose and Kubernetes
# probe /healthz and /readyz over the network instead.

ENTRYPOINT ["/fetcher"]
