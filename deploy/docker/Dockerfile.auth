# EncoreBOM auth — GENERATED by tools/gen-service
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.auth -t encorebom/auth .

# ---- build ----------------------------------------------------------------
FROM golang:1.24-alpine AS build

WORKDIR /src

# Dependencies first: this layer caches across source changes, which matters
# when thirteen images share the same module graph.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

# CGO off for a static binary that runs on distroless/scratch.
# -trimpath keeps absolute build paths out of the binary, which is both a
# reproducibility and a minor information-disclosure concern.
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/auth ./services/auth

# ---- runtime --------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

# distroless/static: no shell, no package manager, no libc. Nothing to pivot to
# if the process is compromised. `nonroot` runs as uid 65532.
COPY --from=build /out/auth /auth

USER nonroot:nonroot
EXPOSE 8091 9090

# No HEALTHCHECK directive: Kubernetes owns probing via /healthz and /readyz,
# and a container-level healthcheck would need a shell this image does not have.

ENTRYPOINT ["/auth"]
