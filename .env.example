# AxeBOM — environment template
#
# Copy to .env and adjust. .env is gitignored; this file is committed.
# In production every SECRET below comes from Vault/KMS, never from a file.
#
# ----------------------------------------------------------------------------
# THE VALUES HERE ARE RUNNABLE AS-IS against the compose stack. That is
# deliberate. A template whose defaults break the app teaches nobody anything:
# the first run fails, the failure looks like a code bug, and the next person
# edits at random until it starts. Every key below is either a working local
# value or an empty optional.
#
# Two rules for editing this file:
#   1. Every key here MUST be read by code. Grep before adding. A key nobody
#      reads is worse than a missing one — it reads as configured.
#   2. Keys that are read but must stay unset locally say so, and say why.
# ----------------------------------------------------------------------------

# ============================================================================
# Core
# ============================================================================
AXEBOM_ENV=development                 # development | staging | production
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=json                           # json | text

# ============================================================================
# Postgres — one cluster, schema per service. No cross-schema JOINs in SQL.
#
# PORTS ARE IN A DEDICATED 5xxxx RANGE, not the upstream defaults. The original
# dev machine ran other projects already occupying 5432/4222/6379/9000/8200/
# 1025/8025. Colliding means connecting to somebody else's Postgres and getting
# an auth failure that reads like a credential bug.
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=axebom
POSTGRES_USER=axebom

# MUST match POSTGRES_PASSWORD in deploy/compose/docker-compose.yml, which
# defaults to `axebom`. This previously read CHANGE_ME, so anyone who
# exported the template got an authentication failure on first connect.
POSTGRES_PASSWORD=axebom               # SECRET (dev value; Vault in prod)

# The application role MUST NOT have BYPASSRLS and MUST NOT be superuser.
# Row-Level Security is the only tenancy boundary; a superuser connection
# silently disables it. Asserted on every boot. See CLAUDE.md invariant 6.
# This value matches the literal in migrations/bootstrap/0001.
POSTGRES_APP_ROLE=axebom_app
POSTGRES_APP_PASSWORD=axebom_app       # SECRET (dev value; Vault in prod)

# The ONE OTHER application role — read only by workers/sbom/normalize_consumer.py,
# the one deliberate exception to "workers hold no credentials"
# (axebom_shared.config's docstring). Narrower than axebom_app: SELECT/INSERT
# only on the `normalize` schema, plus one column-scoped UPDATE on
# vuln_clusters. See migrations/normalize/0006_alias_snapshot.sql and
# docs/02-CONTRACTS.md §6a.
POSTGRES_NORMALIZE_WRITER_ROLE=axebom_normalize_writer
POSTGRES_NORMALIZE_WRITER_PASSWORD=axebom_normalize_writer   # SECRET (dev value; Vault in prod)

POSTGRES_SSLMODE=disable                  # `require` is forced in production
POSTGRES_MAX_CONNS=20

# ============================================================================
# NATS JetStream — durable work queues + lifecycle events
# ============================================================================
NATS_URL=nats://localhost:54222
NATS_STREAM_JOBS=SCAN_JOBS
NATS_STREAM_EVENTS=SCAN_EVENTS
NATS_STREAM_RESULTS=SCAN_RESULTS

# ============================================================================
# Redis — caching and rate limits only. Never a queue: JetStream owns that.
#
# NOTE: read into config but not yet consumed. Rate limiting is currently
# in-process (libs/go-shared/platform/ratelimit), so with N gateway replicas
# the effective limit is N x the configured one. Adequate for abuse control,
# NOT for quota billing. A shared-Redis limiter is the fix.
# ============================================================================
REDIS_URL=redis://localhost:56379/0

# ============================================================================
# Object storage — raw scan artifacts, rendered reports, source archives.
# Raw artifacts are immutable and never deleted (CLAUDE.md invariant 10):
# fixing a normalizer bug re-normalizes them rather than re-running scanners.
# ============================================================================
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=axebom
S3_ACCESS_KEY=minioadmin                  # SECRET
S3_SECRET_KEY=minioadmin                  # SECRET
S3_FORCE_PATH_STYLE=true                  # required for MinIO

# ============================================================================
# Secrets backend
# ============================================================================
VAULT_ADDR=http://localhost:58200
VAULT_TOKEN=dev-root-token                # SECRET — dev only, matches compose
VAULT_MOUNT=secret                        # KV v2 mount
VAULT_TRANSIT_MOUNT=transit               # signing keys

# ============================================================================
# Auth
# ============================================================================
JWT_ISSUER=axebom
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# MUST be at least 32 bytes — auth.MinSigningKeyBytes. NewIssuer refuses a
# shorter key, which kills 7 of the 8 services at dependency construction.
# This template previously shipped a 22-byte placeholder that did exactly that.
JWT_SIGNING_KEY=dev-only-insecure-signing-key-do-not-use-in-production   # SECRET

# GitHub OAuth — https://github.com/settings/developers
# Scope: read:user user:email repo (repo only if private repos are in scope)
# Leave blank to disable GitHub SSO; the service logs a warning and continues.
# See docs/CREDENTIALS.md for the free setup walkthrough.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=                     # SECRET
GITHUB_REDIRECT_URL=http://localhost:5173/auth/github/callback

# Where to send the user after an OAuth round trip.
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Identity — ZITADEL
# ============================================================================
# ZITADEL is the identity provider. It runs as a pinned, UNMODIFIED container
# (deploy/compose/docker-compose.iam.yml) and is reached over OIDC; no ZITADEL
# server code is linked into an AxeBOM binary. See CLAUDE.md invariant 9.
#
#   task iam:up              start the identity tier
#   axebom iam bootstrap  create the project, roles, apps and dev orgs
#   axebom iam verify     print what a token will actually contain
#
ZITADEL_VERSION=v4.17.1

# The PUBLIC origin, and it must match what the browser types exactly.
# ZITADEL routes on the Host header; any mismatch answers "Instance not found",
# which reads like a database fault and is not one.
#
# ⚠ CHANGING THE DOMAIN LATER MEANS RE-RUNNING THE SETUP PHASE. It is not a
# config edit. Decide it before anything resembling production.
ZITADEL_DOMAIN=localhost
ZITADEL_EXTERNALPORT=5173
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http
ZITADEL_PUBLIC_URL=http://localhost:5173
ZITADEL_ISSUER=http://localhost:5173

# Direct port, bypassing nginx. Exists so `axebom iam bootstrap` works when
# the frontend container is down; it is in the instance's trusted-domain list.
ZITADEL_API_PORT=58080

# ⚠ EXACTLY 32 CHARACTERS, AND EFFECTIVELY UNROTATABLE.
# It encrypts every secret ZITADEL holds at rest. Once an instance is
# initialised with a masterkey, changing it loses access to that data — so back
# it up SEPARATELY from the database. A database backup without the masterkey
# restores nothing.
ZITADEL_MASTERKEY=AxeBOMLocalDevMasterkey32Bytes!!   # SECRET — dev only

# ZITADEL's own database, on the Postgres we already run. Separate database,
# not a schema: it owns eventstore/projections/system, runs its own migrations,
# and has no RLS. `zitadel init` creates both the database and this role using
# the POSTGRES_USER admin credentials above.
ZITADEL_POSTGRES_DB=zitadel
ZITADEL_POSTGRES_USER=zitadel
ZITADEL_POSTGRES_PASSWORD=zitadel         # SECRET — dev only
ZITADEL_POSTGRES_MAXOPENCONNS=25

# The instance IAM_OWNER, created by the setup one-shot.
ZITADEL_ADMIN_ORG=AxeBOM
ZITADEL_ADMIN_USERNAME=axebom-admin
ZITADEL_ADMIN_EMAIL=admin@axebom.test
ZITADEL_ADMIN_PASSWORD=AxeBOM-dev-only1!   # SECRET — dev only

# Token lifetimes. INSTANCE-WIDE, not per-application, and only applied on a
# restart of the API container.
#
# ⚠ 15m, NOT THE 12h DEFAULT. Services validate tokens locally against JWKS
# instead of calling introspection per request, so the access-token lifetime IS
# the revocation window. Twelve hours of validity after a user is disabled is
# not a window anybody would sign off on.
ZITADEL_ACCESS_TOKEN_TTL=15m
ZITADEL_ID_TOKEN_TTL=15m

# Written by `axebom iam bootstrap`, read by the frontend and the services.
# Blank until the bootstrap has run once.
ZITADEL_PROJECT_ID=
ZITADEL_SPA_CLIENT_ID=

# How a SERVICE reaches ZITADEL, as opposed to how the browser does.
#
# ⚠ THIS IS NOT ZITADEL_ISSUER AND MUST NOT BE SET TO IT.
#
# ZITADEL_ISSUER is the public origin and is what every token's `iss` claim
# says, so it is what services validate against. ZITADEL_INTERNAL_URL is where
# they actually connect: inside the compose network the public origin resolves
# to the wrong container, and on the host it is the frontend's port.
#
# Keys are fetched over this address, and the service-token minter calls it
# while overriding the Host header so the token it gets back still carries the
# public issuer (see libs/go-shared/oidcauth/servicetoken.go).
#
# Host default below; compose overrides it with http://zitadel-api:8080.
ZITADEL_INTERNAL_URL=http://localhost:58080

# Overrides the key-set URL. Empty derives it from ZITADEL_INTERNAL_URL, which
# is what you want; set it only for an external IdP that publishes keys
# somewhere other than /oauth/v2/keys.
ZITADEL_JWKS_URL=

# The machine-user key a service presents when calling another service. Only
# campaign and fetcher need one. Empty uses
# deploy/compose/.data/zitadel-bootstrap/service-keys/svc-<service>.json, which
# is exactly where `axebom iam bootstrap` writes them.
ZITADEL_SERVICE_KEY_PATH=

# The ZITADEL bootstrap admin key, mounted into the gateway ONLY
# (deploy/compose/docker-compose.app.yml) to power self-service organisation
# signup (services/gateway/internal/signup). Empty means the feature is off —
# see config.OIDC.ProvisioningKeyPath for why there is no narrower credential
# to hand it instead. Local `go run` of the gateway needs this set to exercise
# signup outside compose; the compose stack sets it itself.
ZITADEL_BOOTSTRAP_KEY=

# How long a resolved account stays cached in a service process.
#
# A SECOND control after the token lifetime, not a substitute for it. Longer
# than ZITADEL_ACCESS_TOKEN_TTL would let a role outlive the token that carried
# it; the role is part of the cache key, so a role CHANGE is already a miss.
ZITADEL_IDENTITY_CACHE_TTL=60s

# Invite mail goes to mailpit in dev — read it at http://localhost:58025.
ZITADEL_SMTP_FROM=noreply@axebom.test
ZITADEL_ACCESS_LOG=false

# ============================================================================
# Service discovery — CONFIGURED, NEVER DISCOVERED FROM A REQUEST.
# A base URL taken from a header or a database row turns every cross-service
# call into an SSRF. The gateway proxies to these; nothing else may.
# ============================================================================
AUTH_URL=http://localhost:8091
PROJECT_URL=http://localhost:8092
SCAN_ORCHESTRATOR_URL=http://localhost:8093
REPORT_URL=http://localhost:8094
CAMPAIGN_URL=http://localhost:8095
COMMENT_URL=http://localhost:8096
NOTIFICATION_URL=http://localhost:8097

# ============================================================================
# HTTP server tuning (per service)
#
# METRICS_PORT IS DELIBERATELY ABSENT. It is a single global variable, so
# setting it forces all 8 services onto one port and every service after the
# first dies with "address already in use". Each service derives its own
# metrics port as HTTP_PORT + 10000 (18080, 18091, ...). Set it only when
# running exactly one service, and never in a shared .env.
# ============================================================================
SHUTDOWN_GRACE=20s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# ============================================================================
# Report signing — detached signature per report (CERT-In §5.3.3, p.32)
# Ed25519 via Vault Transit. Consumers verify with `axebom verify <report>`.
#
# This is a bare Vault Transit KEY NAME, not a URL. Left empty, reports are
# stored unsigned and the service warns on boot.
# ============================================================================
REPORT_SIGNING_KEY=

# ============================================================================
# Scan sandbox — see docs/05-SECURITY-MODEL.md
# These are the blast-radius limits for running third-party scanners over
# untrusted user code. Loosening any of them is a security decision.
#
# The Go sandbox policy (libs/go-shared/sandbox) is authoritative and is NOT
# settable from the Python bridge — network cannot be enabled, credentials
# cannot be injected. These tune the Python-side declared limits only.
# ============================================================================
SANDBOX_NETWORK=none                      # none | allowlist — `none` for a reason
SANDBOX_CPU_MILLIS=2000
SANDBOX_MEMORY_MB=4096
SANDBOX_DISK_MB=20480
SANDBOX_PIDS_MAX=512
SANDBOX_WALL_CLOCK_SEC=900

# Package-manager resolution executes arbitrary user code (npm lifecycle
# scripts, Gradle build files). OFF by default. Enabling it is a per-project
# opt-in surfaced in the UI as a risk acknowledgement — never a global flag.
ALLOW_PACKAGE_MANAGER_RESOLUTION=false

# ============================================================================
# Worker filesystem roots
# ============================================================================
AXEBOM_WORKSPACE_ROOT=/var/lib/axebom/workspaces
AXEBOM_OUTPUT_ROOT=/var/lib/axebom/artifacts

# Provisioned vulnerability databases (~4.5 GB). A vulnerability engine runs
# ONLY against a database we provisioned and stamped — no stamp, no run.
# osv-scanner with no database prints {"results": []} and exits 0, which is
# indistinguishable from a genuinely clean project, so the run is refused
# instead. Provision with: python -m workers.sbom.dbsync --all
AXEBOM_ENGINE_DB_ROOT=/var/lib/axebom/enginedb

# Path to the axebom CLI, used by the Python sandbox bridge to shell out to
# `axebom sandbox run`. Defaults to `axebom` on PATH.
AXEBOM_BIN=axebom

# ============================================================================
# OSINT engines
# ============================================================================
OSINT_MANIFEST=OSINT/tools.manifest.yaml
OSINT_TOOLS_DIR=.axebom/tools

# Dependency-Check needs an NVD API key. Without one it is heavily throttled
# and the first database sync takes 30-60 minutes.
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=                              # SECRET

# Hardware part enrichment. Pluggable: nexar | mouser | manual.
# `manual` is the default so no external API is ever a hard dependency.
# Both providers have a free tier — see docs/CREDENTIALS.md.
PART_DATA_PROVIDER=manual
NEXAR_TOKEN=                              # SECRET — OAuth access token
MOUSER_API_KEY=                           # SECRET

# Hugging Face read token — model metadata for aibom-generator. Free.
HUGGINGFACE_TOKEN=                        # SECRET

# ============================================================================
# Observability — OPTIONAL
#
# The collector is behind `profiles: [observability]` and is NOT started by
# `task dev`. Leave the endpoint empty to disable tracing entirely; a failure
# to reach a configured collector only warns, it never blocks startup.
#   docker compose ... --profile observability up -d
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=axebom

# ============================================================================
# Notification email. Defaults point at Mailpit (SMTP_PORT above), which needs
# no username/password. SMTP_FROM is this platform's fixed sender identity —
# per-subscription webhook secrets are resolved from Vault, never from here.
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@axebom.test

# ============================================================================
# NOT YET READ BY ANY CODE — listed so nobody sets them expecting an effect.
#
# WEBHOOK_SIGNING_SECRET — subscription signing secrets are resolved from
# Vault per subscription, never from a global.
#
# Clone limits are enforced with compiled-in constants today:
#   FETCH_MAX_ARCHIVE_MB, FETCH_MAX_FILES, FETCH_MAX_INFLATION_RATIO,
#   FETCH_CLONE_TIMEOUT_SEC, SANDBOX_RUNTIME
#
# Dependency-Track is an OPTIONAL EXPORT TARGET, never a scanner, and needs
# ~6 GB. No integration code exists yet:
#   DEPENDENCY_TRACK_ENABLED, DEPENDENCY_TRACK_URL, DEPENDENCY_TRACK_API_KEY
#
# ai-bom --llm-enrich sends code context to a third party. Not wired:
#   AIBOM_LLM_ENRICH
#
# The frontend reads NEITHER of these — it uses relative /api paths through
# the Vite dev proxy (and the gateway in production), so no build-time base
# URL is needed:
#   VITE_API_BASE_URL, VITE_WS_BASE_URL
# ============================================================================

# ============================================================================
# Compose only
# ============================================================================
# The host's docker group id, granted to the scan worker so it can reach
# /var/run/docker.sock without running privileged. It differs per host.
#   getent group docker | cut -d: -f3
DOCKER_GID=986

# The developer's primary group id, so the campaign and fetcher containers can
# read the 0640 machine keys that `axebom iam bootstrap` writes under your
# own account. `id -g` on Linux/macOS. Irrelevant on Docker Desktop for
# Windows, which does not map host ownership onto bind mounts.
#
# The alternative — writing those keys world-readable — hands a service
# credential to every local account on the machine.
HOST_GID=1000

