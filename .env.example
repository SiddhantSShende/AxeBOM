# EncoreBOM — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is committed.
# In production every SECRET below comes from Vault/KMS, never from a file.

# ============================================================================
# Core
# ============================================================================
ENCOREBOM_ENV=development                 # development | staging | production
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=json

# ============================================================================
# Postgres — one cluster, schema per service. No cross-schema JOINs in SQL.
#
# PORTS ARE IN A DEDICATED 5xxxx RANGE, not the upstream defaults. This machine
# runs other projects that already occupy 5432/4222/6379/9000/8200/1025/8025.
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=encorebom
POSTGRES_USER=encorebom
POSTGRES_PASSWORD=CHANGE_ME               # SECRET

# The application role MUST NOT have BYPASSRLS and MUST NOT be superuser.
# Row-Level Security is the only tenancy boundary; a superuser connection
# silently disables it. See CLAUDE.md invariant 6.
POSTGRES_APP_ROLE=encorebom_app
POSTGRES_APP_PASSWORD=encorebom_app       # SECRET (dev default; Vault in prod)

# ============================================================================
# NATS JetStream — durable work queues + lifecycle events
# ============================================================================
NATS_URL=nats://localhost:54222
NATS_STREAM_JOBS=SCAN_JOBS
NATS_STREAM_EVENTS=SCAN_EVENTS
NATS_STREAM_RESULTS=SCAN_RESULTS

# ============================================================================
# Redis — caching and rate limits only. Never a queue: JetStream owns that.
# ============================================================================
REDIS_URL=redis://localhost:56379/0

# ============================================================================
# Object storage — raw scan artifacts, rendered reports, source archives.
# Raw artifacts are immutable and never deleted (CLAUDE.md invariant 10):
# fixing a normalizer bug re-normalizes them rather than re-running scanners.
# ============================================================================
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=encorebom
S3_ACCESS_KEY=minioadmin                  # SECRET
S3_SECRET_KEY=minioadmin                  # SECRET
S3_FORCE_PATH_STYLE=true                  # required for MinIO

# ============================================================================
# Secrets backend
# ============================================================================
VAULT_ADDR=http://localhost:58200
VAULT_TOKEN=dev-root-token                # SECRET — dev only

# ============================================================================
# Auth
# ============================================================================
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MIN    # SECRET

# GitHub OAuth — https://github.com/settings/developers
# Scope: read:user user:email repo (repo only if private repos are in scope)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=                     # SECRET
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# ============================================================================
# Report signing — detached signature per report (CERT-In §5.3.3, p.32)
# Ed25519. Consumers verify with `encorebom verify <report>`.
# ============================================================================
REPORT_SIGNING_KEY_REF=vault://encorebom/report-signing
REPORT_SIGNING_PUBLIC_KEY=                # published so consumers can verify

# ============================================================================
# Scan sandbox — see docs/05-SECURITY-MODEL.md
# These are the blast-radius limits for running third-party scanners over
# untrusted user code. Loosening any of them is a security decision.
# ============================================================================
SANDBOX_RUNTIME=docker                    # docker | gvisor | kubernetes
SANDBOX_NETWORK=none                      # none | allowlist  — `none` is the default for a reason
SANDBOX_CPU_MILLIS=2000
SANDBOX_MEMORY_MB=4096
SANDBOX_DISK_MB=20480
SANDBOX_PIDS_MAX=512
SANDBOX_WALL_CLOCK_SEC=900

# Clone limits. Defeat decompression bombs and repo-size DoS.
FETCH_MAX_ARCHIVE_MB=2048
FETCH_MAX_FILES=500000
FETCH_MAX_INFLATION_RATIO=100
FETCH_CLONE_TIMEOUT_SEC=600

# Package-manager resolution executes arbitrary user code (npm lifecycle
# scripts, Gradle build files). OFF by default. Enabling it is a per-project
# opt-in surfaced in the UI as a risk acknowledgement — never a global flag.
ALLOW_PACKAGE_MANAGER_RESOLUTION=false

# ============================================================================
# OSINT engines
# ============================================================================
OSINT_MANIFEST=OSINT/tools.manifest.yaml
OSINT_TOOLS_DIR=.encorebom/tools

# Dependency-Check needs an NVD API key. Without one it is heavily throttled
# and the first database sync takes 30-60 minutes.
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=                              # SECRET

# Dependency-Track — OPTIONAL, export target only, not a scanner.
# Requires 4GB heap minimum (docs recommend 8-12GB). Compose profile `heavy`.
DEPENDENCY_TRACK_ENABLED=false
DEPENDENCY_TRACK_URL=http://localhost:58081
DEPENDENCY_TRACK_API_KEY=                 # SECRET

# Hardware part enrichment. Pluggable: nexar | mouser | manual.
# `manual` is the default so no paid API is ever a hard dependency.
PART_DATA_PROVIDER=manual
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=                      # SECRET
MOUSER_API_KEY=                           # SECRET

# Trusera ai-bom --llm-enrich resolves concrete model names but needs an LLM
# key and sends code context to a third party. Off by default.
AIBOM_LLM_ENRICH=false

# ============================================================================
# Notifications
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=51025                           # mailpit in dev
SMTP_USERNAME=
SMTP_PASSWORD=                            # SECRET
SMTP_FROM=noreply@encorebom.local
WEBHOOK_SIGNING_SECRET=                   # SECRET — HMAC on outbound webhooks

# ============================================================================
# Observability
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:54317
OTEL_SERVICE_NAMESPACE=encorebom
METRICS_PORT=9090

# ============================================================================
# Frontend (Vite — VITE_* is exposed to the browser; never put a secret here)
# ============================================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/api/v1
