# AxeBOM — line-ending and diff policy
#
# WHY THIS FILE MATTERS MORE THAN USUAL: development happens on Windows, and
# the normalizer's correctness guarantee rests on golden-file diffs. If Git
# rewrites CRLF into a .golden file, every golden test fails for a reason that
# has nothing to do with the code. That failure mode wastes entire sessions.
#
# NOTE: git requires ONE pattern per line. `*.png *.jpg binary` is silently
# invalid ("not a valid attribute name") — it does not error the commit, it
# just does not apply. Keep one pattern per line.

# Normalize everything to LF in the repository.
* text=auto eol=lf

# --- Golden files: byte-exact, never touched, never diffed as text ----------
# These are the guardrail against silently wrong BOM output. Any transformation
# invalidates them.
*.golden                 -text -diff
fixtures/**/expected/**  -text -diff
fixtures/**/raw/**       -text -diff

# --- Generated / standards artifacts: exact bytes matter -------------------
*.cdx.json      -text
*.spdx.json     -text
*.spdx          -text
*.sarif         -text

# --- Binary ----------------------------------------------------------------
*.pdf           binary
*.xlsx          binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.zst           binary
*.gz            binary
*.zip           binary
*.tar           binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary

# --- Scripts and config that must stay LF even on Windows checkout ---------
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# --- Windows-only files keep CRLF ------------------------------------------
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Language hints for diffs ----------------------------------------------
*.go            text diff=golang
*.py            text diff=python
*.md            text diff=markdown

# --- Lockfiles: versioned, but kept out of review diffs --------------------
go.sum                      -diff
frontend/package-lock.json  -diff
