forms eager DNS name resolution for hostname inputs at deserialization time. An application that binds untrusted JSON into a type containing an InetSocketAddress field issues an attacker-chosen DNS query during readValue, before any application-level validation or connect logic. The fix uses InetSocketAddress.createUnresolved(host, port), deferring DNS to an explicit connect. This vulnerability is fixed in 2.18.8, 2.21.4, and 3.1.4.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-54514","epss":0.00219,"percentile":0.12658,"date":"2026-08-15"}],"cwes":[{"cve":"CVE-2026-54514","cwe":"CWE-918","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"java-matcher","searchedBy":{"language":"java","namespace":"github:language:java","package":{"name":"com.fasterxml.jackson.core:jackson-databind","version":"2.15.2"}},"found":{"vulnerabilityID":"GHSA-hgj6-7826-r7m5","versionConstraint":">=2.0.0,<2.18.8 (unknown)"},"fix":{"suggestedVersion":"2.18.8"}}],"artifact":{"id":"pkg:maven/com.fasterxml.jackson.core/jackson-databind@2.15.2?package-id=b9189706674cde1c","name":"jackson-databind","version":"2.15.2","type":"java-archive","locations":[{"path":"/pom.xml","accessPath":""}],"language":"java","licenses":[],"cpes":["cpe:2.3:a:com.fasterxml.jackson.core:jackson-databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:com.fasterxml.jackson.core:jackson_databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:com.fasterxml.jackson.core:jackson:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:jackson-databind:jackson-databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:jackson-databind:jackson_databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:jackson_databind:jackson-databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a:jackson_databind:jackson_databind:2.15.2:*:*:*:*:*:*:*","cpe:2.3:a