 caching proxy that doesn't ignore responses with cookies, not setting a Cache-Control header to mark pages as private or non-cacheable, and accessing the session in a way that only touches keys without reading values or mutating the session. The issue has been fixed in version 3.1.3.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:L/I:N/A:N","metrics":{"baseScore":4.3,"exploitabilityScore":2.9,"impactScore":1.5},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":2.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-27205","epss":0.00344,"percentile":0.27423,"date":"2026-08-15"}],"cwes":[{"cve":"CVE-2026-27205","cwe":"CWE-524","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"flask","version":"2.3.2"}},"found":{"vulnerabilityID":"GHSA-68rp-wp8r-4726","versionConstraint":"<3.1.3 (python)"},"fix":{"suggestedVersion":"3.1.3"}}],"artifact":{"id":"pkg:pypi/flask@2.3.2?package-id=5f2c27b3326c86e4","name":"flask","version":"2.3.2","type":"python","locations":[{"path":"/requirements.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python-flask:python-flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:python-flask:python_flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:python_flask:python-flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:python_flask:python_flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python-flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python_flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:flask:python-flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a:flask:python_flask:2.3.2:*:*:*:*:*:*:*","cpe:2.3:a: