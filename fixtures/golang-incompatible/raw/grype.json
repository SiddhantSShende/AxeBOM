m pull a specially crafted image that would be considered as a valid cache candidate for some build steps. 23.0+ users are only affected if they explicitly opted out of Buildkit (DOCKER_BUILDKIT=0 environment variable) or are using the /build API endpoint. All users on versions older than 23.0 could be impacted. Image build API endpoint (/build) and ImageBuild function from github.com/docker/docker/client is also affected as it the uses classic builder by default. Patches are included in 24.0.9 and 25.0.2 releases.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","metrics":{"baseScore":7.8,"exploitabilityScore":1.9,"impactScore":5.9},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:C/C:L/I:H/A:L","metrics":{"baseScore":6.9,"exploitabilityScore":1.1,"impactScore":5.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-24557","epss":0.00258,"percentile":0.1768,"date":"2026-08-15"}],"cwes":[{"cve":"CVE-2024-24557","cwe":"CWE-345","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2024-24557","cwe":"CWE-346","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2024-24557","cwe":"CWE-346","source":"nvd@nist.gov","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"go-module-matcher","searchedBy":{"language":"go","namespace":"github:language:go","package":{"name":"github.com/docker/docker","version":"v24.0.5+incompatible"}},"found":{"vulnerabilityID":"GHSA-xw73-rw38-6vjc","versionConstraint":"<24.0.9 (go)"},"fix":{"suggestedVersion":"24.0.9"}}],"artifact":{"id":"pkg:golang/github.com/docker/docker@v24.0.5%2Bincompatible?package-id=723be37636119189","name":"github.com/docker/docker","version":"v24.0.5+incompatible","type":"go-module","locations":[{"path":"/go.mod","accessPath":""}],"language":"go","licenses":[],"cpes":["cpe:2.3:a:docker:docker:v24.